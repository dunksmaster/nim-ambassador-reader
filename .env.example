# Key from https://build.nvidia.com
# Copy this file to .env and fill in the value, or export it in your shell.
# Never commit a real key. .env is gitignored.
NVIDIA_API_KEY=

# Optional. Overrides the default model nvidia/nemotron-3-super-120b-a12b.
# An explicit model does not fall back to another model.
# NVIDIA_MODEL=
